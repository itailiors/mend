{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "MEND Design Tokens",
    "version": "1.0.0",
    "aesthetic": "Precision Sound-Lab Bench (Vintage Japanese Hi-Fi Oscilloscope x Teenage Engineering OP-1)"
  },
