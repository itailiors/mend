  "typography": {
    "fontFamily": {
      "display": "'Space Grotesk', system-ui, -apple-system, sans-serif",
      "sans": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "scale": {
      "xs": "0.6875rem",
      "sm": "0.75rem",
      "md": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem"
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.5
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "layout": {
    "touchTargetMin": "48px",
    "topBarHeight": "52px",
    "barRulerHeight": "24px",
    "collapsedLaneHeight": "44px",
    "transportDockHeight": "76px",
    "appMaxWidthDesktop": "760px"
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "pill": "999px"
  },
  "shadows": {
    "keycap": "0 2px 0 rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08)",
    "well": "inset 0 2px 6px rgba(0, 0, 0, 0.45)",
    "panel": "0 14px 36px rgba(0, 0, 0, 0.42)",
    "glowHealed": "0 0 20px rgba(46, 230, 166, 0.35)",
    "glowGlitch": "0 0 18px rgba(255, 84, 104, 0.35)",
    "glowFocus": "0 0 16px rgba(255, 209, 102, 0.28)"
  },
  "zIndex": {
    "base": 1,
    "playhead": 15,
    "dock": 30,
    "sheet": 40,
    "modal": 60,
    "overlay": 80,
    "toast": 100
  },
  "breakpoints": {
    "mobile": "390px",
    "mobileLarge": "480px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px"
  },
  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "160ms",
      "base": "260ms",
      "accordion": "340ms",
      "shake": "360ms",
      "healSweep": "520ms",
      "victoryUnfold": "640ms"
    },
    "easing": {
      "snappy": "cubic-bezier(0.22, 1, 0.36, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "linear": "linear"
    }
  }
}
